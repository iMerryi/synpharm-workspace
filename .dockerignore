# =============================================================================
# 镜像构建上下文排除规则
#
# 构建上下文是**仓库根**（Maven 多模块根在根目录），根目录同时住着前端、算法服务、
# 部署编排与本地备份。实测这些加起来约 850 MB（synpharm-frontend 715 MB + .git 120 MB），
# 不排除会让**每一次** docker build 都把它们传给 daemon。
#
# 原则：镜像只需要 pom.xml + 各模块 pom.xml + 三个源码目录
#   （synpharm-common/src、synpharm-api/src、${MODULE}/src），其余一律挡掉。
# =============================================================================

# ---------- 机密：绝不能进构建上下文 ----------
# 根 .env 存着数据库口令、JWT 密钥、内部令牌；Dockerfile 不 COPY 它，
# 但让它进入 context 本身就是不该开的口子。
**/.env
**/.env.local

# ---------- 非 Java 服务：镜像由各自的构建方式产出 ----------
synpharm-frontend/
synpharm-fastapi/
synpharm-deploy/

# ---------- 版本控制与 IDE 配置 ----------
.git/
.github/
.idea/
.vscode/

# ---------- 根级本地备份与验证脚本（不是源码） ----------
_synpharm-*.zip
_synpharm-*.sql
e2e-*.ps1
**/*.md

# ---------- 构建产物 ----------
*/target/
target/
**/node_modules/
**/dist/
